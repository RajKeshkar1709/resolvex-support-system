{
  "info": {
    "name": "ResolveX Support System API",
    "description": "Comprehensive Postman Collection for ResolveX Support Ticket Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Customer\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@resolvex.com\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Tickets (User)",
      "item": [
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Payment Gateway Timeout\",\n  \"description\": \"Encountering 504 error during Stripe checkout step\",\n  \"category\": \"BILLING\",\n  \"priority\": \"HIGH\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tickets", "host": ["{{baseUrl}}"], "path": ["api", "tickets"] }
          }
        },
        {
          "name": "Get My Tickets",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/tickets?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "tickets"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "10"}] }
          }
        },
        {
          "name": "Get Ticket By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/tickets/:id", "host": ["{{baseUrl}}"], "path": ["api", "tickets", ":id"] }
          }
        },
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Attaching transaction reference TX-984210\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tickets/:id/comments", "host": ["{{baseUrl}}"], "path": ["api", "tickets", ":id", "comments"] }
          }
        }
      ]
    },
    {
      "name": "Admin Management",
      "item": [
        {
          "name": "Get All Tickets",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/tickets?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "admin", "tickets"] }
          }
        },
        {
          "name": "Update Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/tickets/:id/status", "host": ["{{baseUrl}}"], "path": ["api", "admin", "tickets", ":id", "status"] }
          }
        },
        {
          "name": "Update Priority",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"URGENT\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/tickets/:id/priority", "host": ["{{baseUrl}}"], "path": ["api", "admin", "tickets", ":id", "priority"] }
          }
        },
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["api", "admin", "dashboard", "stats"] }
          }
        },
        {
          "name": "Get Global Activity",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/activity", "host": ["{{baseUrl}}"], "path": ["api", "admin", "activity"] }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ]
}
