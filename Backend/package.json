{
  "name": "resolvex-backend",
  "version": "1.0.0",
  "description": "ResolveX Support Ticket Management System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
